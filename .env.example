APP_ENV=development
LOG_LEVEL=INFO

CORS_ORIGINS=http://localhost:4200

CORPUS_DIR=data/raw
ARTIFACTS_DIR=artifacts
QDRANT_PATH=artifacts/rag/qdrant

GEMINI_API_KEY=
GEMINI_MODEL=

# Chemins relatifs à la racine du dépôt. Sans surcharge, les chemins d'index
# sont dérivés de ARTIFACTS_DIR. Décommenter pour choisir les modèles exportés.
# CLASSIFICATION_MODEL_PATH=artifacts/naive_bayes/mon_run/predictor.joblib
# NER_MODEL_DIR=artifacts/ner/mon_run/best_model
# LEXICAL_INDEX_PATH=artifacts/lexical_search/current.json
# NER_INDEX_PATH=artifacts/ner/entity_index/index.json
# RAG_INDEX_PATH=artifacts/rag/current.json
# RAG_ENCODER_DIR=artifacts/rag/encoder
QDRANT_COLLECTION=legal_passages
INFERENCE_DEVICE=cpu
LEXICAL_TOP_K=10
RAG_TOP_K=5
RAG_BATCH_SIZE=32
GEMINI_TIMEOUT_MS=30000
GEMINI_MAX_ATTEMPTS=3
GEMINI_MAX_OUTPUT_TOKENS=2048
GEMINI_TEMPERATURE=0.2
